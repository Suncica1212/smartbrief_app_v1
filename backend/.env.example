NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# Exact origins only, comma-separated. Never use * in production.
CORS_ORIGINS=https://suncica1212.github.io,http://localhost:8080

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=smartbrief
MYSQL_USER=smartbrief
MYSQL_PASSWORD=change-me
MYSQL_SSL=false

S3_ENDPOINT=http://minio:9000
S3_REGION=ch-dk-2
S3_BUCKET=smartbrief-dev-private
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
APP_ENCRYPTION_KEY_VERSION=1
TOKEN_PEPPER=replace-with-a-separate-long-random-secret

MAX_IMAGE_INPUT_BYTES=26214400
MAX_OPTIMIZED_IMAGE_BYTES=12582912
MAX_FILE_BYTES=52428800
MAX_PROJECT_BYTES=157286400
IMAGE_MAX_EDGE=5000
IMAGE_QUALITY=88
DEFAULT_RETENTION_DAYS=90
DELETE_BATCH_SIZE=25
DELETE_INTERVAL_MINUTES=15
